{#
 # Shown at the bottom of the "Escalate" tab of the entity configuration (see config.html.twig), when
 # some rules assign a technician group: link to the page that switches them to "Escalate to group".
 #}

{% if call('GlpiPlugin\\Moreoptions\\EscalationRule::hasRulesToReview') %}
    <div class="alert alert-info d-flex align-items-center gap-3 mt-3 mx-2">
        <i class="ti ti-list-check fs-2"></i>
        <div class="flex-grow-1">
            {{ __('You have business rules that currently assign a technician to a ticket, change, or problem. You can update them here using the “Escalate to group” action.', 'moreoptions') }}
        </div>
        <a class="btn btn-sm btn-outline-info" href="{{ path('/plugins/moreoptions/front/escalation_rules.php') }}">
            <i class="ti ti-arrow-right"></i>
            <span>{{ __('Check rules', 'moreoptions') }}</span>
        </a>
    </div>
{% endif %}
