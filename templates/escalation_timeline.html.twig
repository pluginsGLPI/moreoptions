{#
 # Rendered through the core `Hooks::TIMELINE_ACTIONS` hook (see Escalation::showTimelineScripts()).
 # The header of timeline entries is rendered by GLPI core, so this only drops an invisible anchor +
 # script that moves the "internal" icon of escalation entries into their "Created: ... by ..."
 # badge, after a small separator.
 #}
<span id="{{ marker_id }}" style="display: none;" aria-hidden="true"></span>
<script>
(function() {
    var marker = document.getElementById({{ marker_id|json_encode|raw }});
    var container = marker ? marker.closest('#itil-object-container') : null;
    if (!container) {
        return;
    }

    container.querySelectorAll('.timeline-item.moreoptions-escalation').forEach(function(entry) {
        var private_icon = entry.querySelector('.timeline-item-buttons .is-private');
        var badge = entry.querySelector('.timeline-header .creator .badge');
        if (!private_icon || !badge) {
            return;
        }

        var separator = document.createElement('span');
        separator.className = 'moreoptions-escalation-separator mx-1';
        separator.setAttribute('aria-hidden', 'true');
        separator.textContent = '|';

        private_icon.classList.remove('ms-2');
        badge.append(separator, private_icon);
    });
})();
</script>
