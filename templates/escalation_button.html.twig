{#
 # Rendered through the core `Hooks::TIMELINE_ACTIONS` hook (see Escalation::showEscalateButton()).
 # The "Assigned to" field is rendered by GLPI core, so this only drops an invisible anchor +
 # script that adds a small "Escalate" button next to its label. The button opens the escalation
 # form in a modal (see ajax/escalation_form.php).
 #}
<span id="{{ marker_id }}" style="display: none;" aria-hidden="true"></span>
<script>
(function() {
    var marker = document.getElementById({{ marker_id|json_encode|raw }});
    var container = marker ? marker.closest('#itil-object-container') : null;
    if (!container) {
        return;
    }

    var label_row = container.querySelector('[data-testid="form-field-assign"] > .d-flex');
    if (!label_row || label_row.querySelector('.moreoptions-escalate-btn')) {
        return;
    }

    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn btn-sm btn-ghost-secondary moreoptions-escalate-btn ms-2 py-0 px-1';
    button.title = {{ __('Escalate', 'moreoptions')|json_encode|raw }};
    button.innerHTML = '<i class="ti ti-arrow-up me-1"></i>'
        + '<span>' + _.escape({{ __('Escalate', 'moreoptions')|json_encode|raw }}) + '</span>';
    button.addEventListener('click', function() {
        glpi_ajax_dialog({
            url: {{ path('/plugins/moreoptions/ajax/escalation_form.php')|json_encode|raw }},
            method: 'get',
            params: {
                itemtype: {{ itemtype|json_encode|raw }},
                items_id: {{ items_id|json_encode|raw }},
            },
            title: {{ __('Escalate', 'moreoptions')|json_encode|raw }},
            dialogclass: 'modal-lg',
        });
    });

    label_row.appendChild(button);
})();
</script>
