{#
 # Escalation form, loaded in the modal opened by the "Escalate" button next to the "Assigned to"
 # field (see escalation_button.html.twig and ajax/escalation_form.php).
 #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set rand = random() %}

<div class="moreoptions-escalation-form">
    <form name="asset_form" style="width: 100%;" class="d-flex flex-column" method="post"
          action="{{ path('/plugins/moreoptions/front/escalation.form.php') }}"
          enctype="multipart/form-data" data-track-changes="true" data-submit-once>

        <input type="hidden" name="itemtype" value="{{ item.getType() }}" />
        <input type="hidden" name="items_id" value="{{ item.getID() }}" />
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

        <div class="row">
            <div class="col-12 col-md-8">
                {{ fields.textareaField(
                    'content',
                    '',
                    '',
                    {
                        'full_width': true,
                        'no_label': true,
                        'enable_richtext': true,
                        'entities_id': item.fields['entities_id'],
                        'rand': rand,
                        'aria_label': __('Comment', 'moreoptions'),
                    }
                ) }}
            </div>

            <div class="col-12 col-md-4">
                <div class="row">
                    {% set group_lbl %}
                        <i class="{{ 'Group'|itemtype_icon }} me-1" title="{{ 'Group'|itemtype_name }}"></i>
                    {% endset %}
                    {{ fields.dropdownField(
                        'Group',
                        'groups_id',
                        0,
                        group_lbl,
                        {
                            'full_width': true,
                            'icon_label': true,
                            'required': true,
                            'entity': item.fields['entities_id'],
                            'condition': {'is_assign': 1},
                            'rand': rand,
                            'aria_label': 'Group'|itemtype_name,
                        }
                    ) }}

                    {% set observer_lbl %}
                        <i class="ti ti-eye me-1" title="{{ __('Assign me as an observer', 'moreoptions') }}"
                           data-bs-toggle="tooltip" data-bs-placement="top"></i>
                    {% endset %}
                    {{ fields.sliderField(
                        'add_me_as_observer',
                        0,
                        observer_lbl,
                        {
                            'full_width': true,
                            'icon_label': true,
                            'rand': rand,
                        }
                    ) }}

                    {% set private_label %}
                        <i class="ti ti-lock fa-fw me-1" title="{{ __('Private') }}" data-bs-toggle="tooltip" data-bs-placement="top"></i>
                    {% endset %}

                    {{ fields.sliderField(
                        'is_private',
                        1,
                        private_label,
                        {
                            'full_width': true,
                            'icon_label': true,
                            'rand': rand,
                        }
                    ) }}
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" type="submit" name="add">
                <i class="ti ti-arrow-up"></i>
                <span>{{ __('Escalate', 'moreoptions') }}</span>
            </button>
        </div>
    </form>
</div>
