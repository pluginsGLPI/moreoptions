{% import '@moreoptions/components/segmented_control.html.twig' as mo %}

{% set rand = random() %}

{% set canedit = params['canedit'] ?? false %}
{% set can_inherit = parent_entity_id is not null %}

{# Option lists, built once: the inherit choice only exists below the root entity. #}
{% set yes_no_set = [] %}
{% if can_inherit %}
    {% set yes_no_set = [{'v': config_parent, 'label': __('Inherit', 'moreoptions'), 'inherit': true}] %}
{% endif %}
{% set yes_no_set = yes_no_set|merge([
    {'v': 0, 'label': __('No'), 'inherit': false},
    {'v': 1, 'label': __('Yes'), 'inherit': false},
]) %}

{% set actor_set = [] %}
{% if can_inherit %}
    {% set actor_set = [{'v': config_parent, 'label': __('Inherit', 'moreoptions'), 'inherit': true}] %}
{% endif %}
{% for value, label in dropdown_options %}
    {% set actor_set = actor_set|merge([{'v': value, 'label': label, 'inherit': false}]) %}
{% endfor %}

{#
 # The tabs themselves, and which sections/settings go in each, are built by
 # Config::getScreenTabs() / Config::showForEntity() -- see `tabs` and
 # `sections_by_tab`. Keeping that definition in PHP rather than here is what
 # lets a new setting (including one restricted to a single ITIL type) or a
 # whole new section get added in one place, without touching this template.
 #}

<div class="asset mo-config">
    <form id="mo-config-form-{{ rand }}" action="{{ path('plugins/moreoptions/front/config.form.php') }}" method="post">
        <ul class="nav nav-tabs" role="tablist">
            {% for tab in tabs %}
                <li class="nav-item">
                    <a
                        class="nav-link {{ loop.first ? 'active' : '' }}"
                        id="mo-tab-{{ tab.id }}-{{ rand }}"
                        data-mo-tab="{{ tab.id }}"
                        data-bs-toggle="tab"
                        href="#mo-pane-{{ tab.id }}-{{ rand }}"
                        role="tab"
                        aria-controls="mo-pane-{{ tab.id }}-{{ rand }}"
                        aria-selected="{{ loop.first ? 'true' : 'false' }}"
                    >
                        <i class="ti {{ tab.icon }}"></i>
                        &nbsp;{{ tab.label }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <div class="tab-content pt-2">
            {% for tab in tabs %}
                <div
                    class="mo-pane {{ loop.first ? 'active' : '' }}"
                    id="mo-pane-{{ tab.id }}-{{ rand }}"
                    role="tabpanel"
                    aria-labelledby="mo-tab-{{ tab.id }}-{{ rand }}"
                >
                    {% for section in sections_by_tab[tab.id] %}
                        <div class="hr-text hr-text-left">
                            <i class="fa-2x ti {{ section.icon }}"></i>
                            <span>{{ section.title }}</span>
                        </div>
                        {% if section.note is defined %}
                            <div class="text-secondary small mb-2">{{ section.note }}</div>
                        {% endif %}

                        <div class="row">
                            {% for row in section.rows %}
                                {% set options = row.kind == 'actor' ? actor_set : yes_no_set %}
                                {% set current = item.fields[row.field]|default(can_inherit ? config_parent : 0) %}
                                {% set disabled = (row.warn_on|default(null) == tab.id) and escalade_takes_technician_group %}

                                <div class="form-field row align-items-center col-12 my-2 mx-2">
                                    <div class="col-6 text-xxl-start">
                                        <label class="col-form-label p-0">{{ row.label }}</label>
                                        {% if disabled %}
                                            <div class="mo-row-warn">
                                                <i class="ti ti-alert-triangle"></i>
                                                <span>{{ __('The "Use the technician\'s group" option from Escalade is enabled and takes precedence over this one.', 'moreoptions') }}</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-6 d-flex align-items-center justify-content-end gap-2">
                                        {% if row.kind == 'profiles' %}
                                            {% if parent_badges[row.field] is defined %}
                                                <div class="mo-inherited">{{ parent_badges[row.field]|raw }}</div>
                                            {% endif %}
                                            <div class="mo-profiles">
                                            {{ call('Dropdown::showFromArray', [row.field, profile_options, {
                                                'multiple': true,
                                                'values': profiles_values[row.field],
                                                'width': '320px',
                                                'disabled': not canedit,
                                                'display': false,
                                            }])|raw }}
                                            </div>
                                        {% elseif row.kind == 'status' %}
                                            {% if parent_badges[row.field] is defined %}
                                                <div class="mo-inherited">{{ parent_badges[row.field]|raw }}</div>
                                            {% endif %}
                                            <div class="mo-status">
                                            {{ call('Dropdown::showFromArray', [row.field, status_options[row.field], {
                                                'value': current,
                                                'width': '220px',
                                                'disabled': disabled or not canedit,
                                                'templateResult': 'templateItilStatus',
                                                'templateSelection': 'templateItilStatus',
                                                'display': false,
                                            }])|raw }}
                                            </div>
                                        {% else %}
                                            {{ mo.render(row.field, options, current, parent_badges[row.field]|default(null), disabled, canedit, rand) }}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="hr my-1" style="opacity: 0.075;"></div>
                            {% endfor %}
                        </div>
                    {% endfor %}

                    {% if tab.id == 'escalate' %}
                        {{ include('@moreoptions/escalation_rules_banner.html.twig') }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {{ include('components/form/buttons.html.twig') }}
    </form>

    {#
     # Escalation tree of the entity, below the settings of the "Escalate filter" tab: outside of
     # the form above, the editor having its own (see group_link.html.twig). On this tab, a single
     # "Save" button, below the tree, saves both: the tree first, then the settings.
     #}
    <div id="mo-escalation-tree-{{ rand }}" class="mt-3 {{ (tabs|first).id != 'escalate_filter' ? 'd-none' }}">
        <div class="hr-text hr-text-left">
            <i class="fa-2x ti ti-hierarchy-2"></i>
            <span>{{ __('Escalation tree', 'moreoptions') }}</span>
        </div>
        {{ include('@moreoptions/group_link.html.twig', escalation_tree, with_context = false) }}

        {% if canedit %}
            {# Same bar as the buttons of the form (see components/form/buttons.html.twig) #}
            <div class="form-button-separator card-body mx-n2 mt-3 border-top d-flex flex-row-reverse align-items-start flex-wrap">
                <button type="button" class="btn btn-primary" data-mo-save-all>
                    <i class="ti ti-device-floppy"></i>
                    <span>{{ _x('button', 'Save') }}</span>
                </button>
            </div>
        {% endif %}
    </div>
</div>

<script>
    (() => {
        // The page is reloaded once saved: back on the tab it was saved from.
        const form = document.getElementById('mo-config-form-{{ rand }}');
        const key = 'moreoptions_config_tab';
        try {
            const saved = sessionStorage.getItem(key);
            sessionStorage.removeItem(key);
            const tab = saved !== null ? form.querySelector(`[data-mo-tab="${CSS.escape(saved)}"]`) : null;
            if (tab !== null) {
                bootstrap.Tab.getOrCreateInstance(tab).show();
            }
        } catch {
            // No storage (private browsing): the first tab is shown.
        }

        form.addEventListener('submit', () => {
            try {
                sessionStorage.setItem(key, form.querySelector('.nav-link.active')?.dataset.moTab ?? '');
            } catch {
                // Same
            }
        });
    })();
</script>

<script>
    (() => {
        const form = document.getElementById('mo-config-form-{{ rand }}');
        const tree = document.getElementById('mo-escalation-tree-{{ rand }}');
        // The buttons of the form give way to the one below the tree.
        const buttons = form.querySelector('.form-button-separator');
        const show = (tab_id) => {
            const is_filter = tab_id === 'mo-tab-escalate_filter-{{ rand }}';
            tree.classList.toggle('d-none', !is_filter);
            buttons?.classList.toggle('d-none', is_filter);
        };
        document.querySelectorAll('[id^="mo-tab-"][id$="-{{ rand }}"]').forEach((tab) => {
            tab.addEventListener('shown.bs.tab', () => show(tab.id));
        });
        show(form.querySelector('.nav-link.active')?.id);

        // "Inherit" and the profiles exclude each other: choosing one removes the other(s).
        const inherit = '{{ config_parent }}';
        $(form).find('.mo-profiles select').on('select2:select', (event) => {
            const chosen = event.params.data.id;
            const values = $(event.target).val() ?? [];
            const kept = chosen === inherit ? [inherit] : values.filter(value => value !== inherit);
            if (kept.length !== values.length) {
                $(event.target).val(kept).trigger('change');
            }
        });

        tree.querySelector('[data-mo-save-all]')?.addEventListener('click', (event) => {
            const button = event.currentTarget;
            const editor = [...(window.GlpiPluginMoreoptionsEscalationGraph?.instances ?? [])]
                .find(instance => tree.contains(instance.container));
            button.disabled = true;
            // The settings are only saved once the tree is: a refused tree shows why, and keeps both.
            (editor?.save() ?? Promise.resolve(true)).then((saved) => {
                if (saved) {
                    form.requestSubmit(form.querySelector('button[name="update"]'));
                } else {
                    button.disabled = false;
                }
            });
        });
    })();
</script>
