{#
 # Arrows of the graph, in its toolbar (included by editor.html.twig). With the right to edit the
 # links, the arrows of the strategies are the choice of the strategy of the links drawn; then
 # comes the dashed arrow of the links replicated from a parent entity. Each one is explained in
 # its tooltip.
 #
 # @param strategies       See TreeView::getTemplateVariables()
 # @param drawing_strategy Strategy of the links drawn in the graph
 # @param canedit
 # @param uid              Unique part of the ids of the fields
 #}
{% import '@moreoptions/components/group_link/macros.html.twig' as macros %}

<div class="d-flex align-items-center gap-2">
    {% if canedit %}
        {{ macros.choices(
            'drawing_strategy',
            'drawing_strategy',
            strategies|map(strategy => strategy|merge({'title': __('Link to draw', 'moreoptions') ~ ': ' ~ strategy.label ~ '. ' ~ strategy.description})),
            drawing_strategy,
            uid,
            __('Link to draw', 'moreoptions'),
        ) }}
    {% else %}
        {% for strategy in strategies %}
            <span class="d-inline-flex align-items-center gap-2 small text-secondary" data-bs-toggle="tooltip" title="{{ strategy.description }}">
                {{ macros.arrow(strategy.color) }}
                {{ strategy.label }}
            </span>
        {% endfor %}
    {% endif %}
    {% for strategy in strategies|filter(strategy => strategy.replicable) %}
        {% set label = __('%s, replicated from a parent entity', 'moreoptions')|format(strategy.label) %}
        <span class="d-inline-flex align-items-center px-1" data-bs-toggle="tooltip" title="{{ label }}" aria-label="{{ label }}">
            {{ macros.arrow(strategy.color, true) }}
        </span>
    {% endfor %}
</div>
