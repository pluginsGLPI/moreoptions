{#
 # Side panel of the selected link (included by editor.html.twig): its groups, from the one
 # escalating to the one receiving the escalations (clicking one selects it), its strategy, and the
 # button to delete it. A link replicated from a parent entity cannot be changed here, only removed
 # from the entity.
 #
 # @param selected_link See TreeView::getTemplateVariables()
 # @param strategies    Strategies a link can have
 # @param canedit
 #}
{% import '@moreoptions/components/group_link/macros.html.twig' as macros %}

<div class="mo-gl-selection">
    <div class="card-header">
        <h3 class="card-title" tabindex="-1" data-mo-panel-title>{{ __('Link', 'moreoptions') }}</h3>
    </div>

    <div class="card-body d-flex flex-column gap-3">
        {# From the group escalating to the group receiving the escalations #}
        <div class="d-flex align-items-center gap-2">
            {% for side in [
                {'id': selected_link.from_id, 'name': selected_link.from_name, 'hint': __('Escalates to the child group', 'moreoptions')},
                {'id': selected_link.to_id, 'name': selected_link.to_name, 'hint': __('Receives the escalations of the parent group', 'moreoptions')},
            ] %}
                {% if not loop.first %}
                    {{ macros.arrow(selected_link.color, selected_link.replicated) }}
                {% endif %}
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill text-truncate" data-mo-action="select_node" data-mo-group="{{ side.id }}"
                        data-bs-toggle="tooltip" title="{{ side.hint }}">
                    <span class="text-truncate">{{ side.name }}</span>
                </button>
            {% endfor %}
        </div>

        {% if selected_link.replicated %}
            <div class="alert alert-info mb-0 py-2" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="ti ti-corner-right-down"></i>
                    <span data-bs-toggle="tooltip" title="{{ __('Deleting it here removes it from this entity and its child entities.', 'moreoptions') }}">
                        {{ __('Inherited from %s', 'moreoptions')|format('<strong>' ~ selected_link.entity_name|e ~ '</strong>')|raw }}
                    </span>
                </div>
            </div>
        {% else %}
            {# The strategy, as the arrows of the toolbar #}
            {{ macros.choices(
                'link_type',
                'set_link_type',
                strategies|map(strategy => strategy|merge({'title': strategy.description})),
                selected_link.type,
                selected_link.key,
                __('Link type', 'moreoptions'),
                not canedit,
                'w-100',
            ) }}
        {% endif %}
    </div>

    {% if canedit %}
        {{ macros.delete_button('delete_link', __('Delete the link', 'moreoptions')) }}
    {% endif %}
</div>
