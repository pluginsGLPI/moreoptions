{#
 # A single field's worth of options, rendered as a compact button group
 # instead of a dropdown: every possible value -- and the one currently
 # active -- is readable at a glance, without opening anything.
 #
 # Backed by plain radio inputs sharing `field` as their name, so the value
 # they send on submit is exactly what a <select> used to send: nothing else
 # in the form, or in front/config.form.php, needs to know this isn't one.
 #}
{% macro render(field, options, current, parent_badge = null, disabled = false, canedit = true, rand = null) %}
    {% if parent_badge %}
        {# GLPI's own inherited-value badge (Entity::inheritedValue()), built
           server-side -- outside the button group, to its left. #}
        <div class="mo-inherited">{{ parent_badge|raw }}</div>
    {% endif %}
    <div class="mo-seg me-2" role="radiogroup">
        {% for option in options %}
            {# `rand` keeps these ids unique if this whole tab ever ends up rendered
               twice on the same page (GLPI caches a loaded tab's DOM instead of
               reloading it -- see config.html.twig). #}
            {% set input_id = 'mo-' ~ field ~ '-' ~ option.v ~ (rand is not null ? '-' ~ rand : '') %}
            <input
                type="radio"
                id="{{ input_id }}"
                name="{{ field }}"
                value="{{ option.v }}"
                class="{{ option.inherit ? 'mo-seg-inherit' : '' }}"
                {{ option.v == current ? 'checked' : '' }}
                {{ disabled or not canedit ? 'disabled' : '' }}
            />
            <label
                for="{{ input_id }}"
                title="{{ option.inherit ? __('Follow the parent entity', 'moreoptions') : option.label }}"
            >
                {% if option.inherit %}<i class="ti ti-corner-left-up-double"></i>{% endif %}
                {{ option.label }}
            </label>
        {% endfor %}
    </div>
{% endmacro %}
